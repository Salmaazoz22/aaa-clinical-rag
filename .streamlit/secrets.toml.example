# Streamlit secrets — copy to `.streamlit/secrets.toml` for local runs, or paste
# the contents into Streamlit Community Cloud under "App settings -> Secrets".
#
# `.streamlit/secrets.toml` is git-ignored and must never be committed.
#
# ONE setting is required by the Streamlit frontend, because the frontend is a
# pure HTTP client with no retrieval, embedding or generation code of its own:
# it needs the public URL of the FastAPI backend. Without it the app falls back
# to http://127.0.0.1:8000, which cannot work in the cloud — nothing listens on
# the container's own loopback address, and the UI then reports "Backend
# unavailable". See docs/DEPLOYMENT.md.
#
# The NAME matters: `ui/api_client.API_URL_SETTINGS` reads `API_URL` first and
# `CLINICAL_RAG_API_URL` second. A URL set under any other name is not read.

API_URL = "https://aaa-clinical-rag-production.up.railway.app"

# ---------------------------------------------------------------------------
# Voice input (speech-to-text) — required for the Whisper feature
# ---------------------------------------------------------------------------
# The voice composer transcribes a recording IN THE FRONTEND, before the text
# is submitted as an ordinary question, so this credential belongs here and not
# with the backend. Set ONE of the two; OPENAI_API_KEY wins if both are present.
#
#   GROQ_API_KEY    -> api.groq.com/openai/v1   whisper-large-v3
#   OPENAI_API_KEY  -> api.openai.com           whisper-1
#
# With neither set, the voice popover says so plainly and text input is
# unaffected — nothing else in the app degrades.
#
# Put a REAL key here. A template placeholder (`your_groq_api_key_here`) is
# rejected by ui/settings.is_placeholder rather than sent to the provider,
# because sending one produces a `401 Invalid API Key` that reads like a
# revoked credential instead of an unconfigured app. That was a live defect.
GROQ_API_KEY = "<your-groq-api-key>"

# Nothing else belongs here. The generation keys used by the RAG pipeline
# (GROQ_API_KEY / OPENROUTER_API_KEY on the BACKEND) and the vector store
# settings (QDRANT_URL, QDRANT_API_KEY, QDRANT_COLLECTION) are read by the
# backend process and must be set wherever that is deployed. The frontend calls
# no vendor except the speech provider above.
