# Streamlit secrets — copy to `.streamlit/secrets.toml` for local runs, or paste
# the contents into Streamlit Community Cloud under "App settings -> Secrets".
#
# `.streamlit/secrets.toml` is git-ignored and must never be committed.
#
# ONE setting is required by the Streamlit frontend, because the frontend is a
# pure HTTP client with no retrieval, embedding or generation code of its own:
# it needs the public URL of the FastAPI backend. Without it the app falls back
# to http://127.0.0.1:8000, which cannot work in the cloud — nothing listens on
# the container's own loopback address, and the UI then reports "Backend
# unavailable". See docs/DEPLOYMENT.md.
#
# The NAME matters: `ui/api_client.API_URL_SETTINGS` reads `API_URL` first and
# `CLINICAL_RAG_API_URL` second. A URL set under any other name is not read.

API_URL = "https://aaa-clinical-rag-production.up.railway.app"

# Nothing else belongs here. The model API keys (GROQ_API_KEY,
# OPENROUTER_API_KEY) and the vector store settings (QDRANT_URL,
# QDRANT_API_KEY, QDRANT_COLLECTION) are read by the BACKEND process, not by
# the UI, and must be set wherever the backend is deployed. Putting them in the
# frontend's secrets would publish them to a process that has no use for them.
