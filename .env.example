# Qdrant connection settings for the production vector store.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed;
# this file documents the variable NAMES only and must never contain a real
# key, password or token.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Local development (docker compose up -d)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aaa_clinical_v1

# ---------------------------------------------------------------------------
# Qdrant Cloud / remote deployment
# ---------------------------------------------------------------------------
# QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=<paste-your-cluster-api-key-here-do-not-commit>
# QDRANT_COLLECTION=aaa_clinical_v1

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Use gRPC instead of REST (lower per-request overhead).
QDRANT_PREFER_GRPC=false

# Client timeout, seconds.
QDRANT_TIMEOUT=30

# Force exhaustive search instead of the HNSW approximation. The validated
# retriever is exhaustive cosine over 991 vectors, so this defaults to true.
QDRANT_EXACT_SEARCH=true

# Offline fallback: run the qdrant-client in embedded local mode against a
# directory instead of a server. Development and tests only, never production.
# Set it and QDRANT_URL is ignored.
# QDRANT_LOCAL_PATH=.qdrant_local

# ---------------------------------------------------------------------------
# Generation layer (Day 3) -- grounded answering over retrieved evidence
# ---------------------------------------------------------------------------
# Which provider answers. Switching provider is this one line.
#   groq        -> openai/gpt-oss-120b        fast iteration during development
#   openrouter  -> deepseek/deepseek-r1:free  final / evaluated answers
GENERATION_PROVIDER=groq

# API keys. Both are read from the environment and never committed; leave the
# one you are not using empty.
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=

# Optional OpenRouter app attribution (sent as HTTP-Referer / X-Title).
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=

# Optional overrides. Unset means the pinned default in generation/config.py,
# so an unset variable can never silently change which model was evaluated.
# GENERATION_MODEL=
# GENERATION_BASE_URL=

# How many chunks to retrieve per question (Day 3 specification: 5).
GENERATION_TOP_K=5

# Evidence-quality floor: cosine similarity below which a chunk is not usable
# evidence and is not sent to the model. If nothing clears it, the layer refuses.
# 0.75 is a starting value to be tuned, not a calibrated one -- see
# generation/config.py and docs/generation.md.
GENERATION_SCORE_THRESHOLD=0.75

# Deterministic decoding for a re-runnable evaluation.
GENERATION_TEMPERATURE=0.0

# Both supported models are reasoning models: their reasoning tokens share this
# budget with the JSON answer, so a small limit truncates the answer.
GENERATION_MAX_OUTPUT_TOKENS=4000
GENERATION_TIMEOUT=180
