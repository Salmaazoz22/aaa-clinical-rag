# Qdrant connection settings for the production vector store.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed;
# this file documents the variable NAMES only and must never contain a real
# key, password or token.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Local development (docker compose up -d)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aaa_clinical_v1

# ---------------------------------------------------------------------------
# Qdrant Cloud / remote deployment
# ---------------------------------------------------------------------------
# QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=<paste-your-cluster-api-key-here-do-not-commit>
# QDRANT_COLLECTION=aaa_clinical_v1

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Use gRPC instead of REST (lower per-request overhead).
QDRANT_PREFER_GRPC=false

# Client timeout, seconds.
QDRANT_TIMEOUT=30

# Force exhaustive search instead of the HNSW approximation. The validated
# retriever is exhaustive cosine over 991 vectors, so this defaults to true.
QDRANT_EXACT_SEARCH=true

# Offline fallback: run the qdrant-client in embedded local mode against a
# directory instead of a server. Development and tests only, never production.
# Set it and QDRANT_URL is ignored.
# QDRANT_LOCAL_PATH=.qdrant_local

# ---------------------------------------------------------------------------
# Generation layer (Day 3) -- grounded answering over retrieved evidence
# ---------------------------------------------------------------------------
# Which provider answers. Switching provider is this one line.
#   groq        -> openai/gpt-oss-120b       fast iteration during development
#   openrouter  -> openai/gpt-oss-20b:free   second opinion / fallback
GENERATION_PROVIDER=groq

# API keys. Both are read from the environment and never committed; leave the
# one you are not using empty.
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=

# Optional OpenRouter app attribution (sent as HTTP-Referer / X-Title).
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=

# Optional overrides. Unset means the pinned default in generation/config.py,
# so an unset variable can never silently change which model was evaluated.
# GENERATION_MODEL=
# GENERATION_BASE_URL=

# ---------------------------------------------------------------------------
# Cross-provider fallback
# ---------------------------------------------------------------------------
# When the primary provider raises (rate limit, timeout, dead model slug), the
# same request is retried once against the OTHER supported provider. This needs
# BOTH API keys to be set -- with only one key the fallback silently does not
# exist, which is how a Groq 429 became a user-facing 502.
GENERATION_ENABLE_FALLBACK=true

# Which provider is the secondary. Empty means "whichever supported provider is
# not the primary", which is almost always what you want.
# GENERATION_FALLBACK_PROVIDER=openrouter

# The secondary's model slug. Empty means the provider's pinned default
# (openrouter -> openai/gpt-oss-20b:free). SET THIS if the vendor retires the
# pinned slug: a retired model makes every fallback attempt 404, which disables
# the fallback without any other symptom. `deepseek/deepseek-r1:free` was
# withdrawn exactly this way. Any OpenAI-compatible OpenRouter slug works, free
# or paid -- e.g. deepseek/deepseek-r1, z-ai/glm-5.2:free.
# GENERATION_FALLBACK_MODEL=

# Per-provider model overrides, honoured whether the provider is primary or
# secondary (GENERATION_MODEL only reaches the primary).
# GROQ_MODEL=
# OPENROUTER_MODEL=

# How many chunks to retrieve per question (Day 3 specification: 5).
GENERATION_TOP_K=5

# Evidence-quality floor: cosine similarity below which a chunk is not usable
# evidence and is not sent to the model. If nothing clears it, the layer refuses.
# 0.75 is a starting value to be tuned, not a calibrated one -- see
# generation/config.py and docs/generation.md.
GENERATION_SCORE_THRESHOLD=0.75

# Deterministic decoding for a re-runnable evaluation.
GENERATION_TEMPERATURE=0.0

# Both supported models are reasoning models: their reasoning tokens share this
# budget with the JSON answer, so a small limit truncates the answer.
#
# NOTE this is a CEILING, not a reservation the provider must honour. Endpoints
# that meter by tokens-per-minute charge `prompt + max_output_tokens` even when
# the model generates far less, so the value is automatically trimmed down to
# whatever fits the provider's per-request ceiling (see
# GROQ_MAX_REQUEST_TOKENS). Leaving this at 4000 is safe.
GENERATION_MAX_OUTPUT_TOKENS=4000

# ---------------------------------------------------------------------------
# The latency budget
# ---------------------------------------------------------------------------
# Per-provider socket timeout, seconds.
GENERATION_TIMEOUT=60

# Wall-clock budget for ONE generation across the whole fallback chain. This is
# what makes a clinical question either return or fail cleanly in a bounded
# time. Without it the worst case is (timeout x SDK retries x providers) --
# which was 24 minutes, and produced a production incident where every question
# ran 130-190 s and the Streamlit client timed out at 240 s.
# 0 disables the bound; do not do that in a deployment.
GENERATION_DEADLINE=90

# Largest single request each provider will accept, in tokens, counting the
# prompt PLUS the reserved completion budget.
#
# Groq's free tier caps this at 8,000 tokens per minute. With a ~4,250-token
# prompt and a 4,000-token reservation, every answer request asked for 8,287 and
# came back `413 Request too large` -- on every call, deterministically, even
# though the model only generated ~1,200 tokens. Raise it on a paid tier.
# GROQ_MAX_REQUEST_TOKENS=8000
# OPENROUTER_MAX_REQUEST_TOKENS=

# ---------------------------------------------------------------------------
# Streamlit frontend
# ---------------------------------------------------------------------------
# Where the UI finds the FastAPI backend. The UI is a pure HTTP client and has
# no retrieval, embedding or generation code of its own, so this must point at a
# reachable API. The default is http://127.0.0.1:8000, which only works when the
# backend runs on the same host -- a deployed UI MUST set this to the backend's
# public URL. See docs/DEPLOYMENT.md.
#
# On Streamlit Community Cloud this is a SECRET entry, not an environment
# variable (there is no env-var panel); locally either works. `API_URL` is read
# first, `CLINICAL_RAG_API_URL` second -- see ui/api_client.API_URL_SETTINGS.
# API_URL=https://your-backend-host.example.com
# CLINICAL_RAG_API_URL=https://your-backend-host.example.com
